{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaleLoL Companion",
  "version": "0.1.1",
  "identifier": "com.salelol.companion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://qeynytijtqzfukoollqi.supabase.co; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "SaleLoL Companion",
        "width": 500,
        "height": 660,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
